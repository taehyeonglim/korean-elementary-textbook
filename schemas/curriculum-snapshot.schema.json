{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curriculum MCP snapshot",
  "type": "object",
  "required": ["schemaVersion", "source", "retrievedAt", "standard", "topics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "required": ["mcp", "method"],
      "properties": {
        "mcp": { "type": "string", "minLength": 1 },
        "method": { "const": "get_standard" },
        "topicMethod": { "const": "get_topic" },
        "version": { "type": "string" }
      }
    },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "standard": { "type": "object" },
    "topics": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  }
}
