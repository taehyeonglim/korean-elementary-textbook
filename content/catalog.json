        },
        {
          "id": "q3",
          "level": "standard",
          "standardCode": "[2수01-06]",
          "topicId": "kr.mt.math.number-operations.g1-2.s2-01-06.representation",
          "prompt": "36+27을 계산하고, 계산 과정을 식으로 나타내세요.",
          "answer": "63",
          "explanation": "36+20=56, 56+7=63"
        },
