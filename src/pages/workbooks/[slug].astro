---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publishedWorkbooks, type Workbook } from "../../lib/catalog";

export function getStaticPaths() {
  return publishedWorkbooks("math").map((workbook) => ({ params: { slug: workbook.slug }, props: { workbook } }));
}

const { workbook } = Astro.props as { workbook: Workbook };
const target = `${import.meta.env.BASE_URL}math/workbooks/${workbook.slug}/`;
---

<BaseLayout title={`${workbook.title} | 새 주소 안내`} description={`${workbook.title}의 새 주소 안내`} page="legacy" subject="math" canonicalPath={target}>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </Fragment>
  <section class="legacy-redirect">
    <p class="eyebrow">ADDRESS UPDATED</p>
    <h1>학습지 주소가<br />새로 정리됐습니다.</h1>
    <p>이 학습지는 이제 수학 과목 공간에서 볼 수 있습니다.</p>
    <a class="button button--primary" href={target}>새 주소로 이동 <span aria-hidden="true">→</span></a>
  </section>
  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</BaseLayout>
