---
import BaseLayout from "../layouts/BaseLayout.astro";
import { coverPage, publicAsset, publishedWorkbooks } from "../lib/catalog";
import { SUBJECT_LIST } from "../lib/subjects";

const allWorkbooks = publishedWorkbooks();
---

<BaseLayout title="초등 학습지 한 장 | 무료 초등 학습지" page="home">
  <section class="hub-hero" aria-labelledby="hub-title">
    <div class="hub-hero__copy">
      <p class="eyebrow">OPEN WORKSHEET ARCHIVE · 2022 REVISED CURRICULUM</p>
      <h1 id="hub-title">초등 학습지<br />한 장</h1>
      <p>배움의 흐름을 한눈에 보고, 필요한 과목의 한 장을 바로 찾아보세요. 교육과정 성취기준에 연결한 무료 학습지 아카이브입니다.</p>
      <div class="hub-stats" aria-label="프로젝트 현황">
        <div><strong>{SUBJECT_LIST.length}</strong><span>과목 공간</span></div>
        <div><strong>{allWorkbooks.length}</strong><span>공개 학습지</span></div>
        <div><strong>PDF</strong><span>무료 다운로드</span></div>
      </div>
    </div>
    <div class="hub-hero__orbit" aria-hidden="true">
      <span class="orbit-word orbit-word--math">MATH</span>
      <span class="orbit-word orbit-word--english">ENGLISH</span>
      <span class="orbit-word orbit-word--korean">KOREAN</span>
      <i></i><i></i><i></i>
    </div>
  </section>

  <section class="subject-archive" aria-labelledby="subject-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">CHOOSE A SUBJECT</p>
        <h2 id="subject-title">과목을 골라보세요</h2>
      </div>
      <p>같은 원칙과 품질 기준으로 과목별 학습지를 차근차근 확장합니다.</p>
    </div>

    <div class="subject-grid">
      {SUBJECT_LIST.map((subject) => (
        <article class:list={["subject-card", `subject-card--${subject.accent}`]}>
          <div class="subject-card__topline">
            <span>{subject.englishLabel}</span>
            <span class:list={["subject-status", subject.status === "preparing" && "subject-status--preparing"]}>
              {subject.status === "published" ? "공개 중" : "준비 중"}
            </span>
          </div>
          <div class:list={["subject-card__covers", `subject-card__covers--${subject.id}`]} aria-label={`${subject.shortLabel} 학습지 표지`}>
            {publishedWorkbooks(subject.id).slice(0, 3).map((workbook, index) => {
              const cover = coverPage(workbook);
              return cover && <img src={publicAsset(cover.thumbnailPath || cover.imagePath)} alt={`${workbook.title} 표지`} loading={subject.id === "math" && index === 0 ? "eager" : "lazy"} />;
            })}
          </div>
          <div class="subject-card__body">
            <p class="eyebrow">{subject.shortLabel} · {subject.gradeBands.map((band) => `${band}학년군`).join(" · ")}</p>
            <h3>{subject.label}</h3>
            <p>{subject.summary}</p>
            <dl>
              <div><dt>성취기준</dt><dd>{subject.standardCount}개</dd></div>
              <div><dt>영역</dt><dd>{subject.areas.join(" · ")}</dd></div>
            </dl>
            <a class="subject-card__link" href={`${import.meta.env.BASE_URL}${subject.slug}/`}>
              {subject.status === "published" ? "학습지 찾아보기" : "영어 공간 살펴보기"} <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="hub-principles" aria-label="제작 원칙">
    <p class="eyebrow">ONE PAGE, CLEAR PURPOSE</p>
    <div>
      <h2>짧게 배우고<br />분명하게 확인합니다.</h2>
      <p>각 학습지는 교육과정 근거, 접근 가능한 전문, 인쇄용 PDF와 함께 제공합니다. 과목이 늘어나도 이 원칙은 바뀌지 않습니다.</p>
    </div>
  </section>
</BaseLayout>
