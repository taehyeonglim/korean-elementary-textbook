---
import WorkbookCard from "../../components/WorkbookCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GRADE_BAND_LABELS, coverPage, publicAsset, publishedWorkbooks } from "../../lib/catalog";

const workbooks = publishedWorkbooks("math");
const gradeBands = ["1-2", "3-4", "5-6"] as const;
const modules = [...new Set(workbooks.map((workbook) => workbook.module))].sort((a, b) => a.localeCompare(b, "ko"));
const domains = [...new Set(workbooks.map((workbook) => workbook.domain))].sort((a, b) => a.localeCompare(b, "ko"));
const heroCovers = workbooks.slice(0, 3).map((workbook) => {
  const cover = coverPage(workbook);
  return cover ? { src: publicAsset(cover.thumbnailPath || cover.imagePath), alt: `${workbook.title} 표지` } : undefined;
});
---

<BaseLayout title="초등 수학 한 장 | 초등 학습지 한 장" description="2022 개정 교육과정 성취기준에 연결한 무료 초등 수학 학습지 53권" page="subject" subject="math">
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero__copy">
      <a class="subject-backlink" href={import.meta.env.BASE_URL}>초등 학습지 한 장 <span aria-hidden="true">↗</span></a>
      <p class="eyebrow">MATHEMATICS · OPEN WORKSHEET ARCHIVE</p>
      <h1 class="hero__title" id="intro-title">초등 수학<br />한 장</h1>
      <p class="hero__lead">성취기준에 연결한 짧고 정확한 수학 학습지. 아이의 오늘 수학에 딱 맞는 한 장을 찾아, 바로 인쇄해 보세요.</p>
      <p class="hero__note">기초·표준·도전은 학습을 돕기 위한 프로젝트 자체 단계이며, 국가 공식 성취수준은 아닙니다.</p>
      <div class="hero__stats" aria-label="학습지 구성">
        <div><strong>{workbooks.length}</strong><span>학습지</span></div>
        <div><strong>3</strong><span>학습 단계</span></div>
        <div><strong>PDF</strong><span>바로 내려받기</span></div>
      </div>
    </div>
    <div class="hero__fan" aria-label="학습지 표지 미리보기">
      {[0, 1, 2].map((index) => {
        const cover = heroCovers[index];
        return (
          <div class:list={["fan-card", !cover && "fan-card--placeholder"]}>
            {cover ? <img src={cover.src} alt={cover.alt} loading={index === 0 ? "eager" : "lazy"} /> : <span aria-hidden="true">수학</span>}
          </div>
        );
      })}
    </div>
  </section>

  <section class="archive" aria-labelledby="archive-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">FIND YOUR SHEET</p>
        <h2 id="archive-title">학습지 찾아보기</h2>
      </div>
      <p>학년군, 수학 영역, 단원으로 원하는 학습지를 빠르게 좁혀 보세요.</p>
    </div>

    <div class="filter-shell">
      <form class="filter-form" id="filters" aria-label="학습지 필터">
        <label>학년군
          <select name="gradeBand">
            <option value="">전체 학년군</option>
            {gradeBands.map((value) => <option value={value}>{GRADE_BAND_LABELS[value]}</option>)}
          </select>
        </label>
        <label>수학 영역
          <select name="domain">
            <option value="">전체 영역</option>
            {domains.map((value) => <option value={value}>{value}</option>)}
          </select>
        </label>
        <label>단원
          <select name="module">
            <option value="">전체 단원</option>
            {modules.map((value) => <option value={value}>{value}</option>)}
          </select>
        </label>
        <button class="filter-reset" type="reset">초기화</button>
      </form>
    </div>

    <div class="archive-status">
      <p id="result-count" role="status" aria-live="polite"></p>
      <strong>필터 상태는 링크에 저장됩니다</strong>
    </div>
    <ul class="workbook-grid" id="workbook-list" aria-label="학습지 목록">
      {workbooks.map((workbook) => <li><WorkbookCard workbook={workbook} /></li>)}
    </ul>
    <div class="empty-state" id="empty-state" hidden>
      <h3>아직 맞는 한 장이 없어요</h3>
      <p>필터를 하나 지우거나, 다른 학년군과 단원을 살펴보세요.</p>
    </div>
  </section>

  <script is:inline>
    const form = document.querySelector("#filters");
    const listItems = Array.from(document.querySelectorAll("#workbook-list > li"));
    const empty = document.querySelector("#empty-state");
    const count = document.querySelector("#result-count");
    const supportedFields = ["gradeBand", "domain", "module"];

    const loadFromUrl = () => {
      if (!(form instanceof HTMLFormElement)) return;
      const params = new URLSearchParams(window.location.search);
      supportedFields.forEach((name) => {
        const field = form.elements.namedItem(name);
        const value = params.get(name) ?? "";
        if (field instanceof HTMLSelectElement && Array.from(field.options).some((option) => option.value === value)) field.value = value;
      });
    };
    const applyFilters = ({ updateUrl = true } = {}) => {
      if (!(form instanceof HTMLFormElement)) return;
      const values = new FormData(form);
      let visible = 0;
      listItems.forEach((item) => {
        const card = item.querySelector("[data-grade-band]");
        const matches = supportedFields.every((name) => {
          const selected = String(values.get(name) ?? "");
          return !selected || card?.dataset[name] === selected;
        });
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
      if (count) count.textContent = `총 ${visible}개의 학습지`;
      if (updateUrl) {
        const next = new URLSearchParams();
        supportedFields.forEach((name) => {
          const value = String(values.get(name) ?? "");
          if (value) next.set(name, value);
        });
        const query = next.toString();
        window.history.replaceState(null, "", `${window.location.pathname}${query ? `?${query}` : ""}`);
      }
    };

    loadFromUrl();
    applyFilters({ updateUrl: false });
    form?.addEventListener("change", () => applyFilters());
    form?.addEventListener("reset", () => window.requestAnimationFrame(() => applyFilters()));
    window.addEventListener("popstate", () => { loadFromUrl(); applyFilters({ updateUrl: false }); });
  </script>
</BaseLayout>
