---
import WorkbookGallery from "../../../components/WorkbookGallery.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { GRADE_BAND_LABELS, LEVEL_LABELS, publicAsset, publishedWorkbooks, type ProjectLevel, type Workbook } from "../../../lib/catalog";

export function getStaticPaths() {
  return publishedWorkbooks("math").map((workbook) => ({ params: { slug: workbook.slug }, props: { workbook } }));
}

const { workbook } = Astro.props as { workbook: Workbook };
const pages = [...workbook.pages].sort((a, b) => a.order - b.order);
---

<BaseLayout title={`${workbook.title} | 초등 수학 한 장`} description={`${workbook.title} 무료 수학 학습지`} page="workbook" subject="math">
  <article class="workbook-detail">
    <a class="breadcrumb" href={`${import.meta.env.BASE_URL}math/`}><span aria-hidden="true">←</span> 초등 수학 한 장</a>
    <header class="detail-hero">
      <div>
        <p class="eyebrow">{GRADE_BAND_LABELS[workbook.gradeBand]} · {workbook.domain.toUpperCase()}</p>
        <h1 class="detail-hero__title">{workbook.title}</h1>
        <p class="detail-hero__description">{workbook.module} 단원의 핵심 성취기준을 바탕으로 구성한 4쪽 학습지입니다. 개념을 확인하고, 적용하며, 한 번 더 생각하는 흐름으로 풀어보세요.</p>
        <div class="detail-actions">
          {workbook.slug === "angles" && <a class="button button--tablet" href={`${import.meta.env.BASE_URL}math/workbooks/${workbook.slug}/solve/`}>태블릿으로 풀기 <span aria-hidden="true">✎</span></a>}
          <a class="button button--primary" href={publicAsset(workbook.pdf.path)} download>PDF 내려받기 <span aria-hidden="true">↓</span></a>
          <a class="button button--plain" href={publicAsset(workbook.transcriptPath)}>문항·정답 전문 보기 <span aria-hidden="true">↗</span></a>
        </div>
        <p class="level-note">{(workbook.levels as ProjectLevel[]).map((level) => LEVEL_LABELS[level]).join(" · ")}은 프로젝트 자체 학습 단계이며 국가 공식 성취수준이 아닙니다.</p>
      </div>
      <aside class="detail-meta" aria-label="학습지 정보">
        <dl>
          <dt>학년군</dt><dd>{GRADE_BAND_LABELS[workbook.gradeBand]}</dd>
          <dt>수학 영역</dt><dd>{workbook.domain}</dd>
          <dt>단원</dt><dd>{workbook.module}</dd>
          <dt>성취기준</dt><dd><ul class="standard-list">{workbook.standardCodes.map((code) => <li><code>{code}</code></li>)}</ul></dd>
          <dt>구성</dt><dd>표지 · 문제 · 정답·해설 / {workbook.pdf.pageCount}쪽</dd>
        </dl>
      </aside>
    </header>

    <WorkbookGallery workbookTitle={workbook.title} pages={pages} />

    <section class="detail-bottom" aria-label="이용 및 접근성 안내">
      <div class="transcript-panel">
        <p class="eyebrow">ACCESSIBLE TEXT</p>
        <h2>화면 낭독과 답안 확인</h2>
        <p>이미지 속 모든 문제와 정답·해설을 읽을 수 있는 HTML 전문을 제공합니다. 화면 낭독기, 텍스트 확대, 복사 기능이 필요한 경우 이 버전을 이용하세요.</p>
        <a class="button button--plain" href={publicAsset(workbook.transcriptPath)}>접근 가능한 문항·정답 전문 <span aria-hidden="true">↗</span></a>
      </div>
      <aside class="rights-panel">
        <p class="eyebrow">OPEN TO LEARN</p>
        <h2>자유롭게, 바르게</h2>
        <p>프로젝트 자체 문항·편집물은 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ko">CC BY-NC-SA 4.0</a>으로 제공합니다.</p>
        <p>저자: {workbook.author}<br />이미지 제작: GPT Image · Gongnyang Prompt Kit</p>
      </aside>
    </section>
  </article>
</BaseLayout>
