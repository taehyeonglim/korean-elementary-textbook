---
import englishSummary from "../../../content/curriculum/english-summary-2026-07-29.json";
import WorkbookCard from "../../components/WorkbookCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { GRADE_BAND_LABELS, publishedWorkbooks } from "../../lib/catalog";
import { subjectDefinition } from "../../lib/subjects";

const english = subjectDefinition("english");
const gradeBands = Object.entries(englishSummary.gradeBands);
const workbooks = publishedWorkbooks("english");
const domains = [...new Set(workbooks.map((workbook) => workbook.domain))].sort((a, b) => a.localeCompare(b, "ko"));
---

<BaseLayout
  title="초등 영어 한 장 | 초등 학습지 한 장"
  description="2022 개정 영어과 교육과정 40개 성취기준을 모두 연결한 무료 초등 영어 학습지 16권"
  page="subject"
  subject="english"
>
  <section class="english-hero" aria-labelledby="english-title">
    <div>
      <a class="subject-backlink" href={import.meta.env.BASE_URL}>초등 학습지 한 장 <span aria-hidden="true">↗</span></a>
      <p class="eyebrow">ENGLISH · CURRICULUM SPACE</p>
      <h1 id="english-title">초등 영어<br />한 장</h1>
      <p class="english-hero__lead">소리를 듣고 뜻을 이해하며, 익숙한 말과 글로 나를 표현하는 연습. 40개 성취기준을 실제 언어 사용 맥락으로 묶은 6쪽 학습지입니다.</p>
      <div class="preparing-badge"><span aria-hidden="true"></span> {workbooks.length}권 무료 배포 중</div>
    </div>
    <div class="english-letterfield" aria-hidden="true">
      <span>A</span><span>hello</span><span>B</span><span>read</span><span>C</span><span>speak</span>
    </div>
  </section>

  <section class="english-map" aria-labelledby="map-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">2022 REVISED CURRICULUM</p>
        <h2 id="map-title">영어 배움의 지도</h2>
      </div>
      <p>초등 영어는 3학년부터 시작하며, 교육과정은 이해와 표현의 두 영역으로 이어집니다.</p>
    </div>

    <div class="curriculum-stat-grid">
      <article>
        <strong>{english.standardCount}</strong>
        <h3>성취기준</h3>
        <p>3–4학년군 20개와 5–6학년군 20개를 확인했습니다.</p>
      </article>
      {englishSummary.officialAreas.map((area) => (
        <article>
          <strong>{area.labelKorean}</strong>
          <h3>{area.standardCount}개 기준</h3>
          <p>{area.id === "understanding" ? "듣기와 읽기를 중심으로 의미와 정보를 파악합니다." : "말하기와 쓰기를 중심으로 생각과 경험을 나타냅니다."}</p>
        </article>
      ))}
    </div>

    <div class="grade-band-map">
      {gradeBands.map(([band, data]) => (
        <article>
          <div>
            <p class="eyebrow">{band === "3-4" ? "FOUNDATION" : "EXPANSION"}</p>
            <h3>{GRADE_BAND_LABELS[band as "3-4" | "5-6"]}</h3>
          </div>
          <strong>{data.standardCount}개</strong>
          <p>{band === "3-4" ? "알파벳과 기초 어휘에서 시작해 주변의 쉬운 담화를 이해하고 표현합니다." : "강세·리듬·억양을 살피며 일상 주제의 정보와 생각을 더 넓게 이해하고 표현합니다."}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="archive" aria-labelledby="archive-title">
    <div class="section-heading">
      <div><p class="eyebrow">READ · PRACTICE · SPEAK · WRITE</p><h2 id="archive-title">영어 학습지 찾아보기</h2></div>
      <p>학년군과 학습 영역으로 골라 PDF를 내려받거나, 6쪽 전체를 이미지로 넘겨볼 수 있습니다.</p>
    </div>
    <div class="filter-shell">
      <form class="filter-form filter-form--english" id="filters" aria-label="영어 학습지 필터">
        <label>학년군
          <select name="gradeBand"><option value="">전체 학년군</option><option value="3-4">3–4학년군</option><option value="5-6">5–6학년군</option></select>
        </label>
        <label>학습 영역
          <select name="domain"><option value="">전체 영역</option>{domains.map((value) => <option value={value}>{value}</option>)}</select>
        </label>
        <button class="filter-reset" type="reset">초기화</button>
      </form>
    </div>
    <div class="archive-status"><p id="result-count" role="status" aria-live="polite"></p><strong>40개 성취기준 전체 연결</strong></div>
    <ul class="workbook-grid" id="workbook-list" aria-label="영어 학습지 목록">
      {workbooks.map((workbook) => <li><WorkbookCard workbook={workbook} /></li>)}
    </ul>
    <div class="empty-state" id="empty-state" hidden><h3>조건에 맞는 학습지가 없어요</h3><p>필터를 초기화하고 다시 살펴보세요.</p></div>
  </section>

  <script is:inline>
    const form = document.querySelector("#filters");
    const listItems = Array.from(document.querySelectorAll("#workbook-list > li"));
    const empty = document.querySelector("#empty-state");
    const count = document.querySelector("#result-count");
    const fields = ["gradeBand", "domain"];
    const apply = () => {
      if (!(form instanceof HTMLFormElement)) return;
      const values = new FormData(form); let visible = 0;
      listItems.forEach((item) => {
        const card = item.querySelector("[data-grade-band]");
        const matches = fields.every((name) => !String(values.get(name) ?? "") || card?.dataset[name] === String(values.get(name)));
        item.hidden = !matches; if (matches) visible += 1;
      });
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
      if (count) count.textContent = `총 ${visible}개의 영어 학습지`;
    };
    apply(); form?.addEventListener("change", apply); form?.addEventListener("reset", () => requestAnimationFrame(apply));
  </script>
</BaseLayout>
